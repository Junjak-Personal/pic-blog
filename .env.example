# 이 파일은 키 목록 문서다. 실제 값은 .env.local / .env.prd 에 들어간다.
#
#   .env.local   로컬 개발 — `pnpm dev` 가 자동으로 읽는다. URL 제한 없는 퍼블릭 토큰.
#   .env.prd     배포      — `docker run --env-file .env.prd`. URL 제한 건 토큰.
#
# 둘 다 gitignore 되어 있다. 커밋하지 않는다.

# Mapbox 퍼블릭 토큰 (pk.*) — 클라이언트 번들에 실린다
NUXT_PUBLIC_MAPBOX_TOKEN=

# Mapbox Studio 커스텀 다크 스타일
NUXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/junjak/cmt8w8dmu003g01ssg8x254ws

# 세션 쿠키 서명 키 (32자 이상) — openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# 편집 비밀번호 scrypt 해시 — node scripts/hash-password.mjs '<비밀번호>'
# 평문은 절대 넣지 않는다.
NUXT_ADMIN_PASSWORD_HASH=

# SQLite 파일 + 사진 디렉토리
NUXT_DATA_DIR=./data
